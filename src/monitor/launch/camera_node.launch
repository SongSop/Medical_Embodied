<launch>
    <!-- 相机节点启动文件 -->
    <arg name="camera_id" default="0" doc="摄像头ID"/>
    <arg name="frame_width" default="640" doc="帧宽度"/>
    <arg name="frame_height" default="480" doc="帧高度"/>
    <arg name="publish_rate" default="30.0" doc="发布频率(Hz)"/>

    <node name="camera_node" pkg="monitor" type="camera_node.py" output="screen">
        <!-- 相机配置 -->
        <param name="camera_id" value="$(arg camera_id)" />
        <param name="frame_width" value="$(arg frame_width)" />
        <param name="frame_height" value="$(arg frame_height)" />
        <param name="publish_rate" value="$(arg publish_rate)" />

        <!-- 话题名称 -->
        <param name="rgb_topic" value="/camera/rgb/image_raw" />
        <param name="camera_info_topic" value="/camera/rgb/camera_info" />
    </node>
</launch>
