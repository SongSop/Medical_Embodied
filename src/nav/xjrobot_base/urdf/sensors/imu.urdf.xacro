<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 实机专用 IMU 模型。当前安装关系与仿真版本保持一致。 -->
  <xacro:macro name="xjrobot_imu">
    <link name="imu_link"/>

    <joint name="joint_imu" type="fixed">
      <!-- 固定 TF: lidar_3d_link -> imu_link
           实机链路中，MID360 原始数据先由 mid360_rotation_node 同步旋转到
           lidar_3d_link / imu_link 坐标系，再进入后续定位与融合模块。
           因此这里保留的是“补偿后的雷达系 -> 补偿后的 IMU 系”的固定物理外参，
           需与 xjrobot_localization/config/mid360.yaml 中的 extrinsic_T / extrinsic_R 保持一致。 -->
      <origin xyz="-0.03975383 0.011 -0.03014352" rpy="0.0 0.0 0.0" />
      <parent link="lidar_3d_link" />
      <child link="imu_link" />
    </joint>
  </xacro:macro>
</robot>
